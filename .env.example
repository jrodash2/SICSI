# Copie este archivo como .env. Nunca suba .env a Git.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=sicsi
DB_USER=sicsi
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
# localhost para prueba; URL HTTPS real en producción
APP_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=
# Active solo si un proxy confiable elimina/reemplaza X-Forwarded-Proto.
TRUST_PROXY_HTTPS=False
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FROM=
# local imprime correos a consola. Producción requiere smtp.
EMAIL_MODE=console
UPLOAD_MAX_MB=10
PRIVATE_MEDIA_ROOT=private_media
BACKUP_DIR=backups
PG_DUMP_BIN=pg_dump
